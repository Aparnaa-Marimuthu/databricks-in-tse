      "homePageValue": "<!DOCTYPE html>\r\n<html>\r\n\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <title>Blitz Trial Live</title>\r\n     <link href=\"https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600&display=swap\" rel=\"stylesheet\">\r\n</head>\r\n\r\n<body style=\"margin:0; padding:40px 0; background:#f3f3f3; font-family:'Work Sans', Arial, Helvetica, sans-serif;\">\r\n\r\n    <table width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" align=\"center\">\r\n        <tr>\r\n            <td align=\"center\">\r\n\r\n                <!--[if gte mso 9]>\r\n<v:roundrect xmlns:v=\"urn:schemas-microsoft-com:vml\"\r\n arcsize=\"4%\"\r\n stroke=\"false\"\r\n fill=\"true\"\r\n style=\"width:800px;\">\r\n<v:fill type=\"frame\"\r\n src=\"https://lab.blitzdemos.ai/email_assets/gradients/gradient-1000.png\"\r\n color=\"#7D426E\"/>\r\n<v:textbox inset=\"12px,12px,12px,12px\">\r\n<![endif]-->\r\n\r\n                <table width=\"800\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\"\r\n                    background=\"https://lab.blitzdemos.ai/email_assets/gradients/gradient-1000.png\"\r\n                    style=\"background-size:800px 100%; background-repeat:no-repeat; border-radius:32px;\">\r\n\r\n                    <tr>\r\n                        <td style=\"padding:12px;\">\r\n\r\n                            <table width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" bgcolor=\"#ffffff\"\r\n                                style=\"border-radius:24px; overflow:hidden;\">\r\n\r\n                                <!-- Header -->\r\n                                <tr>\r\n                                    <td bgcolor=\"#7D426E\" style=\"padding:20px 28px;\">\r\n                                        <img src=\"https://lab.blitzdemos.ai/email_assets/logos/blitz-logo-white.png\"\r\n                                            style=\"display:block;\" alt=\"Blitz\">\r\n                                    </td>\r\n                                </tr>\r\n\r\n                                <!-- Body -->\r\n                                <tr>\r\n                                    <td style=\"padding:24px 40px; color:#252422;\">\r\n\r\n                                        <h1 style=\"font-size:40px; font-weight:600; line-height:48px; margin:0 0 24px 0;\">\r\n                                            Your 7-day Blitz trial is live.\r\n                                        </h1>\r\n\r\n                                        <p style=\"font-size:20px; line-height:32px; margin:0 0 24px 0;\">\r\n                                            Enter a company name. We’ll build the Blitz demo that sells.\r\n                                        </p>\r\n\r\n                                        <p style=\"font-size:20px; line-height:32px; margin:0 0 24px 0;\">\r\n                                            Start here:\r\n                                        </p>\r\n\r\n                                        <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"\r\n                                            style=\"margin:0 0 24px 0;\">\r\n                                            <tr>\r\n                                                <td style=\"font-size:20px; line-height:32px;\">1. Paste a company URL</td>\r\n                                            </tr>\r\n                                            <tr>\r\n                                                <td style=\"font-size:20px; line-height:32px;\">2. Pick the story (KPIs + outcomes)</td>\r\n                                            </tr>\r\n                                            <tr>\r\n                                                <td style=\"font-size:20px; line-height:32px;\">3. Walk into the demo ready</td>\r\n                                            </tr>\r\n                                        </table>\r\n\r\n                                        <p style=\"font-size:20px; line-height:32px; margin:0 0 24px 0;\">\r\n                                            Tip: choose a real target account. The difference is instant.\r\n                                        </p>\r\n\r\n                                        <p style=\"font-size:20px; line-height:32px; margin:0 0 32px 0;\">\r\n                                            Demo that look like you spent days. Ready in minutes.\r\n                                        </p>\r\n\r\n                                        <!-- Watch a Demo Button -->\r\n                                        <table border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin:0 0 32px 0;\">\r\n                                            <tr>\r\n                                                <td align=\"center\" bgcolor=\"#0E3A84\"\r\n                                                    style=\"width:174px; height:55px; border-radius:6px;\">\r\n                                                    <a href=\"https://www.youtube.com/watch?v=bg8PDRuqMjk&t=2s\"\r\n                                                        style=\"display:inline-block; width:174px; height:55px; line-height:55px; font-size:20px; font-weight:500; color:#ffffff; text-decoration:none; text-align:center;\">\r\n                                                        Watch a demo\r\n                                                    </a>\r\n                                                </td>\r\n                                            </tr>\r\n                                        </table>\r\n\r\n                                        <p style=\"font-size:20px; line-height:32px; margin:0 0 24px 0;\">\r\n                                            Over the next week, we’ll drop some helpful tips with handy info on how to make the most of your time here.\r\n                                        </p>\r\n\r\n                                        <p style=\"font-size:20px; line-height:32px; margin:0 0 24px 0;\">\r\n                                            - <strong>The Blitz Team</strong>\r\n                                        </p>\r\n\r\n                                        <hr style=\"border:0; border-top:1px solid #D7DADD; margin:24px 0;\">\r\n\r\n                                        <p style=\"font-size:20px; line-height:32px; margin:0 0 24px 0;\">\r\n                                            We can’t wait to show you how effortless winning demos can be!\r\n                                        </p>\r\n\r\n                                        <!-- Explore + Social -->\r\n                                        <table width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\"\r\n                                            style=\"margin:0 0 24px 0;\">\r\n                                            <tr>\r\n                                                <td align=\"left\">\r\n                                                    <table border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n                                                        <tr>\r\n                                                            <td align=\"center\" bgcolor=\"#7D426E\"\r\n                                                                style=\"width:200px; height:40px; border-radius:4px;\">\r\n                                                                <a href=\"https://www.blitzdemos.ai/\"\r\n                                                                    style=\"display:inline-block; width:191px; height:40px; line-height:40px; font-size:16px; font-weight:bold; color:#ffffff; text-decoration:none; text-align:center;\">\r\n                                                                    Explore our website\r\n                                                                </a>\r\n                                                            </td>\r\n                                                        </tr>\r\n                                                    </table>\r\n                                                </td>\r\n\r\n                                                <td align=\"right\">\r\n                                                    <table border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n                                                        <tr>\r\n                                                            <td>\r\n                                                                <a href=\"https://www.linkedin.com/company/blitzdemos/?viewAsMember=true\">\r\n                                                                    <img src=\"https://lab.blitzdemos.ai/email_assets/icons/linkedin.png\"\r\n                                                                        width=\"40\" height=\"40\"\r\n                                                                        style=\"display:block;\" alt=\"LinkedIn\">\r\n                                                                </a>\r\n                                                            </td>\r\n                                                            <td width=\"12\"></td>\r\n                                                            <td>\r\n                                                                <a href=\"https://www.youtube.com/@blitzdemos\">\r\n                                                                    <img src=\"https://lab.blitzdemos.ai/email_assets/icons/youtube.png\"\r\n                                                                        width=\"40\" height=\"40\"\r\n                                                                        style=\"display:block;\" alt=\"YouTube\">\r\n                                                                </a>\r\n                                                            </td>\r\n                                                        </tr>\r\n                                                    </table>\r\n                                                </td>\r\n                                            </tr>\r\n                                        </table>\r\n\r\n                                        <p style=\"font-size:16px; line-height:32px; color:#8C857E; margin:0;\">\r\n                                            This is an automatic email, so please don't reply to it. If you have any questions or need more help, drop us a line on the website.\r\n                                        </p>\r\n\r\n                                    </td>\r\n                                </tr>\r\n                            </table>\r\n\r\n                        </td>\r\n                    </tr>\r\n                </table>\r\n\r\n                <!--[if gte mso 9]>\r\n</v:textbox>\r\n</v:roundrect>\r\n<![endif]-->\r\n\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n</body>\r\n\r\n</html>"
